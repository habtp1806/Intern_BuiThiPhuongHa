<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="HelloSelenium" parallel="tests" thread-count="3">

    <listeners>
        <listener class-name="utils.listeners.ReportListener"/>
    </listeners>
    <test name="Chrome Test 1">
        <parameter name="browser" value="chrome"/>
        <parameter name="runmode" value="grid"/>
        <classes>
            <class name="testcases.Chapter10.LogoutTest"/>
        </classes>
    </test>
    <test name="Chrome Test 2">
        <parameter name="browser" value="firefox"/>
        <parameter name="runmode" value="grid"/>
        <classes>
            <class name="testcases.Chapter10.LogoutTest"/>
        </classes>
    </test>
    
</suite>
